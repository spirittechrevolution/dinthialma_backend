# ===================================================================
# Dinthialma Backend – Variables d'environnement
# ===================================================================
# Copier ce fichier en .env et remplir les valeurs avant de lancer
# le docker-compose :
#   cp .env.example .env
#
# ⚠️  Ne jamais committer le fichier .env (déjà dans .gitignore)
# ===================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dinthialma123
POSTGRES_DB=db-dinthialma
POSTGRES_PORT=5434

# ─── pgAdmin ─────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@dinthialma.io
PGADMIN_PASSWORD=pgadmin123
PGADMIN_PORT=5051

# ─── Keycloak ────────────────────────────────────────────────────
KEYCLOAK_DB_NAME=db-keycloak-dinthialma
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8280
KEYCLOAK_REALM=dinthialma
# À créer dans l'interface Keycloak → Clients
KEYCLOAK_CLIENT_ID=dinthialma-client
KEYCLOAK_CLIENT_SECRET=xxxx

# ─── Backend ─────────────────────────────────────────────────────
BACKEND_PORT=8081
BACKEND_TAG=latest

# ─── Email (SMTP Gmail) ──────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@dinthialma.io
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM=no-reply@dinthialma.io
MAIL_FROM_NAME=Dinthialma
ADMIN_EMAIL=admin@dinthialma.io

# ─── SMS – LAfricaMobile ─────────────────────────────────────────
LAM_SMS_URL=https://lamsms.lafricamobile.com/api
LAM_ACCOUNT_ID=CHANGE_ME
LAM_PASSWORD=CHANGE_ME
LAM_SENDER=DINTHIALMA

# ─── Bootstrap Super Admin (premier démarrage uniquement) ──────────
# Mettre enabled=false après le premier login
BOOTSTRAP_ENABLED=true
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@dinthialma.io
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin
BOOTSTRAP_SUPER_ADMIN_PHONE=+221000000000

# ─── Dozzle ──────────────────────────────────────────────────────
DOZZLE_PORT=8889

# ─── VPS (production uniquement) ─────────────────────────────────
VPS_IP=0.0.0.0
MINIO_PUBLIC_ENDPOINT=http://0.0.0.0:9000
GRAFANA_PASSWORD=CHANGE_ME
