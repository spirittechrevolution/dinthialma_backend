# ===================================================================
# Dinthialma – Variables d'environnement PRODUCTION
# ===================================================================
# Copier en .env.prod et remplir TOUTES les valeurs :
#   cp .env.prod.example .env.prod
#
# ⚠️  .env.prod est dans .gitignore – ne jamais committer ce fichier
# ===================================================================

# ─── Domaines ────────────────────────────────────────────────────
# Domaine principal du projet
DOMAIN=dinthialma.com

# Domaine public de Keycloak partagé (infra)
# Doit correspondre à KC_HOSTNAME dans /opt/infra/.env
KEYCLOAK_DOMAIN=auth.spirittech.com

# ─── Tags des images Docker ───────────────────────────────────────
BACKEND_TAG=latest
FRONTEND_TAG=latest
OPENWA_TAG=latest

# ─── PostgreSQL (postgres-shared dans infra) ─────────────────────
# Ces valeurs doivent correspondre à /opt/infra/.env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=db-dinthialma

# ─── Keycloak ────────────────────────────────────────────────────
KEYCLOAK_REALM=dinthialma
KEYCLOAK_CLIENT_ID=dinthialma-client
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_CLIENT_SECRET

# ─── Sécurité ─────────────────────────────────────────────────────
# Clé AES-256 pour le chiffrement des refresh tokens (32 bytes base64)
# Générer : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64_KEY

# ─── SMS – LAfricaMobile ──────────────────────────────────────────
LAM_SMS_URL=https://lamsms.lafricamobile.com/api
LAM_ACCOUNT_ID=CHANGE_ME
LAM_PASSWORD=CHANGE_ME
LAM_SENDER=DINTHIALMA

# ─── WhatsApp – OpenWA ────────────────────────────────────────────
# false = envoi réel, true = mock (logs seulement)
OPENWA_MOCK=false

# ─── Configuration publique de l'application (GET /v1/public/config) ─
# Vide = champ absent de la réponse (le front masque l'élément correspondant).
# Numéro WhatsApp du support, au format international avec + (bouton « Contacter le support »)
SUPPORT_WHATSAPP=
# Adresse e-mail du support
SUPPORT_EMAIL=
# Version minimale du front, SemVer MAJEUR.MINEUR.CORRECTIF (ex. 1.2.0), comparée à la
# version du package.json. Laisser VIDE tant qu'aucune mise à jour forcée n'est voulue ;
# ne renseigner qu'une version DÉJÀ déployée, sinon tous les utilisateurs sont bloqués
# sur l'écran « Mise à jour requise ».
APP_VERSION_MINIMALE=

# ─── Bootstrap Super Admin (1er démarrage uniquement) ────────────
# Passer à false après le premier login réussi
BOOTSTRAP_ENABLED=true
BOOTSTRAP_SUPER_ADMIN_PHONE=221XXXXXXXXX

# ─── Monitoring ───────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
